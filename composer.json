{
    "name": "bluefairy/store-accelerator",
    "description": "Removes WooCommerce scripts and stylesheets from the pages that do not need them.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "BlueFairy\\StoreAccelerator\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFairy\\StoreAccelerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
